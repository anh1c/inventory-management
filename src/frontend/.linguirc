{
    "locales": ["vi", "en"],
    "catalogs": [{
        "path": "src/locales/{locale}/messages",
        "include": ["src", "lib"],
        "exclude": ["**/node_modules/**", "./dist/**"]
    }],
    "format": "po",
    "orderBy": "origin",
    "sourceLocale": "vi",
    "fallbackLocales": {
        "default": "vi"
    }
}
